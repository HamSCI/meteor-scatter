# meteor-scatter configuration
# See https://github.com/HamSCI/meteor-scatter for documentation.
#
# Monitors meteor-scatter activity via WSJT-X's MSK144 protocol, decodes
# heard "pings" with the bundled `jt9` binary, and uploads heard spots to
# wsprdaemon.org under the shared station reporter_id.

[station]
callsign    = "YOURCALL"
grid_square = "AA00aa"
# Optional PSWS identifiers (not required for meteor-scatter operation):
# psws_station_id    = "S000000"
# psws_instrument_id = "0"

[paths]
spool_dir   = "/var/lib/meteor-scatter"
log_dir     = "/var/log/meteor-scatter"

# Decoder.  meteor-scatter decodes MSK144 with `jt9 --msk144 -p 15`.  No jt9
# is bundled: it uses the first of sigmond's UberSDR jt9
# (/usr/local/libexec/sigmond/decoders/ubersdr/jt9, MSK144 since madpsy
# PR #4), sigmond's WSJT-X jt9, then jt9 on PATH, whose help lists --msk144
# (core.decoder.resolve_jt9_binary).  Set `decoder_jt9` only to override that.
decoder_kind = "jt9"
# decoder_jt9 = "/usr/local/libexec/sigmond/decoders/ubersdr/jt9"

# Optional standalone fallback for chain-delay correction (contract v0.3 §8).
# Overridden by RADIOD_<id>_CHAIN_DELAY_NS in coordination.env when present.
# [timing]
# chain_delay_ns = 0

[[radiod]]
# REQUIRED: the mDNS control/status multicast name of the radiod to
# consume from.  Discover available radiods on the LAN with:
#   meteor-scatter config init   (interactive wizard, picks one)
#   ka9q-python list              (raw discovery)
# Leave the placeholder unchanged to make the daemon refuse to start
# until the operator runs the configurator.
status = "<configure-via-config-init>"

# MSK144 meteor-scatter monitoring.  Standard WSJT-X dial frequencies (USB):
#   10 m → 28.145 MHz
#   6 m  → 50.260 MHz   (requires a receiver/radiod path that covers 6 m)
# T/R period: MSK144's nominal transmit and receive period is 15 s, and the
# Meteor Scatter QSO Party records 15 s of audio per slot (Rob Suggs, MSQP
# working group).  The next 15 s holds the other side of a QSO, which gets its
# own slot.  We record 15 s T/R-aligned slots back to back and decode each once
# with `jt9 --msk144 -p 15`.  A station that monitors a 30 s schedule can set 30.
#
# Bandwidth: MSK144 occupies ~2.4-2.5 kHz (2000 baud MSK), centered on the
# 1500 Hz audio Tx point → roughly 300-2750 Hz.  The `usb` preset's filter
# (low=+50, high=+3k → 2950 Hz passband) covers it fully — the same full
# SSB audio width a real WSJT-X station receives on.  Do NOT narrow this;
# a tighter filter would clip the MSK144 sidebands and kill decodes.
[radiod.msk144]
sample_rate   = 12000
preset        = "usb"
encoding      = "s16be"
tr_period_sec = 15
freqs_hz      = [
  28_145_000,
  50_260_000,
]
# Written by calibration, keyed by frequency in Hz as a string:
#[radiod.msk144.scale_db]
#"28145000" = 31.5
#[radiod.msk144.noise_cal_dbfs]
#"28145000" = -81.5

# Meteor Scatter QSO Party archive (docs/OPERATIONS.md, "MSQP").
#[msqp]
#archive_max_days  = 90
#archive_max_gb    = 2
#archive_dtype    = "complex64"   # "f16" keeps capture = "iq" slots as half-size <stem>.iq16.zst
#operator          = ""   # operator names and calls, for the Zenodo description
#contact_email     = ""
#antenna           = ""
#comments          = ""
#zenodo_token_path = "/etc/meteor-scatter/zenodo-token"
